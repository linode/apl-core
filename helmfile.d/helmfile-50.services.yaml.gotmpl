bases:
  - snippets/defaults.yaml
---
bases:
  - snippets/defaults.gotmpl
---
bases:
  - snippets/env.gotmpl
---
bases:
  - snippets/derived.gotmpl
---
{{ readFile "snippets/templates.gotmpl" }}
{{- $v := .Values }}
{{- $a := $v.apps }}

releases:
  - name: trivy-operator
    installed: {{ $a | get "trivy.enabled" }}
    namespace: trivy-operator
    labels:
      pkg: trivy-operator
    <<: *default
    # The release is named trivy-operator but the app is trivy, so common.gotmpl's
    # apps.<release>._rawValues lookup never finds apps.trivy._rawValues. Inject it
    # here, the same way prometheus-operator injects apps.prometheus._rawValues.
    values:
      - ../values/trivy-operator/trivy-operator.gotmpl
      - snippets/common.gotmpl
      - {{- $a | get "trivy._rawValues" dict | toYaml | nindent 8 }}
  - name: kubeflow-pipelines-artifacts
    installed: {{ $a | get "kubeflow-pipelines.enabled" }}
    namespace: kfp
    labels:
      pkg: kubeflow-pipelines
    <<: *raw
  - name: kubeflow-pipelines
    installed: {{ $a | get "kubeflow-pipelines.enabled" }}
    namespace: kfp
    labels:
      pkg: kubeflow-pipelines
    <<: *default
  - name: kserve
    installed: {{ $a | get "kserve.enabled" }}
    namespace: kserve
    labels:
      pkg: kserve
    <<: *default
