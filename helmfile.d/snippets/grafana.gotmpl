analytics:
  check_for_updates: false
  check_for_plugin_updates: false
  feedback_links_enabled: false
# oauth2-proxy sets this header on every request, so Grafana needs no login flow and stores no tokens.
"auth.jwt":
  enabled: true
  header_name: Authorization
  jwk_set_url: {{ .oidcJwksUrl }}
  tls_skip_verify_insecure: {{ .untrustedCA }}
  expect_claims: '{"iss": "{{ .oidcBaseUrl }}"}'
  email_claim: email
  username_claim: email
  auto_sign_up: true
  role_attribute_path: contains(groups[*], 'admin') && 'Admin' || contains(groups[*], 'platform-admin') && 'Admin'
  role_attribute_strict: true
log:
  level: error
users:
  allow_sign_up: false
  auto_assign_org: true
  # fall back to admin for anonymous when no auth is available
  auto_assign_org_role: Viewer
