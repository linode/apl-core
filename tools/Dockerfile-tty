# syntax=docker/dockerfile:1.6
# The above is needed for the "--checksum" aurgument to work in the ADD instruction

FROM alpine:3.23 AS binaries

# Version definitions and checksums
# https://github.com/mikefarah/yq/releases
ARG YQ_VERSION=4.54.1
ARG YQ_CHECKSUM=sha256:8e34fc298390875de416e6a4afcb8cabeceb25d9aa8506c1a2f9353cf702ea5f

# https://github.com/kubernetes/kubernetes/releases
ARG KUBECTL_VERSION=1.36.5
ARG KUBECTL_CHECKSUM=sha256:33bc88a24c3b09cf55bfd59e6ca977881b61fc3f25ab65bc80c65b430248648e

# https://github.com/derailed/k9s/releases
ARG K9S_VERSION=0.51.0
ARG K9S_CHECKSUM=sha256:c3752ad51a5a4015a113819c4eeb6e55a4d0e4b8e652494797532f6fc8161dd7

# https://github.com/helm/helm/releases
ARG HELM_VERSION=4.3.1
ARG HELM_CHECKSUM=sha256:0403a88ae20913d11b10a2467b50087721fea7581736da6b9d3992f5357fe54b

# https://github.com/tektoncd/cli/releases
ARG TKN_VERSION=0.46.2
ARG TKN_CHECKSUM=sha256:f6d86bc7960d85af94eb46f8f480ac8d113aa78e78b15d6f8d2f53d80daab2ce

# https://github.com/cloudnative-pg/cloudnative-pg/releases
ARG CNPG_VERSION=1.30.1
ARG CNPG_CHECKSUM=sha256:784bc46f176b24a150d5de84d0691f10ff613b59456af86b1a4868e1bacb9953
RUN mkdir -p /out

# Installing yq
ADD --chmod=755 --checksum=${YQ_CHECKSUM} https://github.com/mikefarah/yq/releases/download/v${YQ_VERSION}/yq_linux_amd64 /out/yq

# Installing kubectl
ADD --checksum=${KUBECTL_CHECKSUM} https://dl.k8s.io/release/v${KUBECTL_VERSION}/bin/linux/amd64/kubectl /tmp/kubectl
RUN install -o root -g root -m 0755 /tmp/kubectl /out/kubectl && rm /tmp/kubectl

# Installing k9s
ADD --checksum=${K9S_CHECKSUM} https://github.com/derailed/k9s/releases/download/v${K9S_VERSION}/k9s_Linux_amd64.tar.gz /tmp/k9s.tar.gz
RUN tar zxf /tmp/k9s.tar.gz -C /out/ k9s && rm /tmp/k9s.tar.gz

# Installing helm
ADD --checksum=${HELM_CHECKSUM} https://get.helm.sh/helm-v${HELM_VERSION}-linux-amd64.tar.gz /tmp/helm.tar.gz
RUN tar xzf /tmp/helm.tar.gz -C /tmp linux-amd64/helm && \
  mv /tmp/linux-amd64/helm /out/helm && \
  chmod +x /out/helm && \
  rm -rf /tmp/helm.tar.gz /tmp/linux-amd64

# Installing tekton cli
ADD --checksum=${TKN_CHECKSUM} https://github.com/tektoncd/cli/releases/download/v${TKN_VERSION}/tkn_${TKN_VERSION}_Linux_x86_64.tar.gz /tmp/tkn.tar.gz
RUN tar zxf /tmp/tkn.tar.gz -C /out/ tkn && rm /tmp/tkn.tar.gz

# Installing kubectl-cnpg
ADD --checksum=${CNPG_CHECKSUM} https://github.com/cloudnative-pg/cloudnative-pg/releases/download/v${CNPG_VERSION}/kubectl-cnpg_${CNPG_VERSION}_linux_x86_64.tar.gz /tmp/kubectl-cnpg.tar.gz
RUN tar zxf /tmp/kubectl-cnpg.tar.gz -C /out/ kubectl-cnpg && rm /tmp/kubectl-cnpg.tar.gz

FROM alpine:3.23

RUN apk add --no-cache \
  bash \
  bash-completion \
  ca-certificates \
  curl \
  jq \
  less \
  tmux \
  ttyd \
  vim \
  wget

COPY --from=binaries /out/ /usr/local/bin/

RUN addgroup -g 1001 user && adduser -D -u 1001 -G user -h /home/user user

# Set up kubeconfig generation
RUN mkdir /etc/kconfig && \
  echo 'kubectl config set-cluster apl --certificate-authority=/var/run/secrets/kubernetes.io/serviceaccount/ca.crt --server=https://kubernetes.default.svc.cluster.local' > /etc/kconfig/kconfig.sh && \
  echo 'kubectl config set-credentials default-user --token=$(cat /var/run/secrets/kubernetes.io/serviceaccount/token)' >> /etc/kconfig/kconfig.sh && \
  echo 'kubectl config set-context default-context --cluster=apl --namespace=${NAMESPACE} --user=default-user' >> /etc/kconfig/kconfig.sh && \
  echo 'kubectl config use-context default-context' >> /etc/kconfig/kconfig.sh

USER user

# Setting up kubectl autocompletion
RUN touch ~/.bashrc && \
  echo 'source <(kubectl completion bash)' >> ~/.bashrc && \
  echo 'alias k=kubectl' >> ~/.bashrc &&  \
  echo 'complete -o default -F __start_kubectl k' >> ~/.bashrc && \
  echo 'source /etc/kconfig/kconfig.sh > /dev/null' >> ~/.bashrc

WORKDIR /home/user

# Command to start a tmux session and expose it via ttyd.
CMD ["ttyd", "-W", "-p", "8080", "tmux", "new", "-A", "/bin/bash"]
