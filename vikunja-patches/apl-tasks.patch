index 0000000..8029bdb
--- /dev/null
+++ b/src/operators/vikunja/lib/client.ts
@@ -0,0 +1,161 @@
+import { VikunjaTeam, VikunjaTeamMember } from './types/teams'
+import { VikunjaProject, VikunjaTeamProjectShare, VikunjaTeamProjectShareRequest } from './types/projects'
+
+/**
+ * Minimal Vikunja API client.
+ *
+ * Gitea and Harbor get generated clients from `@linode/*-client-fetch`; Vikunja publishes no
+ * such package, so the handful of endpoints this operator needs are written out here. The
+ * shapes come from Vikunja's own swagger.json.
+ *
+ * Only core AGPL endpoints are used. `/admin/*` and `vikunja user set-admin` need the Pro
+ * admin-panel licence, and nothing here does: creating a team and managing its members is
+ * something any authenticated user may do for the teams they own.
+ */
+export class VikunjaClient {
+  private token: string | null = null
+
+  constructor(
+    private readonly baseUrl: string,
+    private readonly username: string,
+    private readonly password: string,
+  ) {}
+
+  private get apiUrl(): string {
+    return `${this.baseUrl.replace(/\/$/, '')}/api/v1`
+  }
+
+  async login(): Promise<void> {
+    const res = await fetch(`${this.apiUrl}/login`, {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify({ username: this.username, password: this.password }),
+    })
+    if (!res.ok) throw new Error(`Vikunja login failed: ${res.status} ${await res.text()}`)
+    const body = (await res.json()) as { token?: string }
+    if (!body.token) throw new Error('Vikunja login returned no token')
+    this.token = body.token
+  }
+
+  private async request<T>(method: string, path: string, body?: unknown): Promise<T> {
+    if (!this.token) await this.login()
+    const send = async () =>
+      fetch(`${this.apiUrl}${path}`, {
+        method,
+        headers: {
+          'Content-Type': 'application/json',
+          Authorization: `Bearer ${this.token}`,
+        },
+        body: body === undefined ? undefined : JSON.stringify(body),
+      })
+
+    let res = await send()
+    // The JWT is short lived. One transparent re-login keeps the operator from
+    // needing a refresh loop of its own.
+    if (res.status === 401) {
+      await this.login()
+      res = await send()
+    }
+    if (!res.ok) throw new VikunjaResponseError(method, path, res.status, await res.text())
+    if (res.status === 204) return undefined as T
+    return (await res.json()) as T
+  }
+
+  async info(): Promise<{ version?: string }> {
+    const res = await fetch(`${this.apiUrl}/info`)
+    if (!res.ok) throw new Error(`Vikunja info failed: ${res.status}`)
+    return (await res.json()) as { version?: string }
+  }
+
+  async listTeams(): Promise<VikunjaTeam[]> {
+    const teams = await this.request<VikunjaTeam[] | null>('GET', '/teams?per_page=500')
+    return teams ?? []
+  }
+
+  async createTeam(team: VikunjaTeam): Promise<VikunjaTeam> {
+    return this.request<VikunjaTeam>('PUT', '/teams', team)
+  }
+
+  async getTeam(id: number): Promise<VikunjaTeam> {
+    return this.request<VikunjaTeam>('GET', `/teams/${id}`)
+  }
+
+  async addTeamMember(teamId: number, username: string): Promise<VikunjaTeamMember> {
+    return this.request<VikunjaTeamMember>('PUT', `/teams/${teamId}/members`, { username })
+  }
+
+  async removeTeamMember(teamId: number, username: string): Promise<void> {
+    await this.request<unknown>('DELETE', `/teams/${teamId}/members/${encodeURIComponent(username)}`)
+  }
+
+  /**
+   * ⛔ This TOGGLES the member's admin flag -- Vikunja has no "set admin to X" call, and the
+   * endpoint takes no body. Only ever call it after reading the member's current `admin` value
+   * and finding it differs from what you want. Called unconditionally it flips the wrong way,
+   * and the next reconcile flips it back, forever.
+   *
+   * ⛔ The path segment is the **username**, not the numeric user id, despite the route being
+   * documented as `{userID}`. Passing the id returns `404 {"code":1005,"message":"The user does
+   * not exist."}` for an id that demonstrably exists — measured against Vikunja 2.5.0 with the
+   * correct id for a real member. Same convention as removeTeamMember above.
+   */
+  async toggleTeamMemberAdmin(teamId: number, username: string): Promise<void> {
+    await this.request<unknown>('POST', `/teams/${teamId}/members/${encodeURIComponent(username)}/admin`)
+  }
+
+  async listProjects(): Promise<VikunjaProject[]> {
+    const projects = await this.request<VikunjaProject[] | null>('GET', '/projects?per_page=500')
+    return projects ?? []
+  }
+
+  async createProject(project: VikunjaProject): Promise<VikunjaProject> {
+    return this.request<VikunjaProject>('PUT', '/projects', project)
+  }
+
+  async listProjectTeams(projectId: number): Promise<VikunjaTeamProjectShare[]> {
+    const teams = await this.request<VikunjaTeamProjectShare[] | null>('GET', `/projects/${projectId}/teams`)
+    return teams ?? []
+  }
+
+  /**
+   * Shares a project with a team at a fixed permission level (0 = Read, 1 = Read & Write,
+   * 2 = Admin). This is a single project<->team relation, not per-member -- Vikunja has no
+   * per-member permission when sharing at the team level, see `models.TeamProject` in its
+   * swagger. Callers that need finer-grained roles must fall back to per-user project shares.
+   */
+  async shareProjectWithTeam(
+    projectId: number,
+    teamId: number,
+    permission: number,
+  ): Promise<VikunjaTeamProjectShareRequest> {
+    return this.request<VikunjaTeamProjectShareRequest>('PUT', `/projects/${projectId}/teams`, {
+      team_id: teamId,
+      permission,
+    })
+  }
+}
+
+export class VikunjaResponseError extends Error {
+  constructor(
+    readonly method: string,
+    readonly path: string,
+    readonly status: number,
+    readonly body: string,
+  ) {
+    super(`Vikunja ${method} ${path} failed: ${status} ${body}`)
+    this.name = 'VikunjaResponseError'
+  }
+}
+
+export function isNotFoundError(error: unknown): boolean {
+  return error instanceof VikunjaResponseError && error.status === 404
+}
+
+/**
+ * Adding a member Vikunja does not know returns 404, and adding one it already has returns
+ * 400. Both are expected -- a user only exists in Vikunja after their first OIDC login --
+ * so neither may be fatal. Verified against Vikunja v2.5.0.
+ */
+export function isMissingOrDuplicateMember(error: unknown): boolean {
+  return error instanceof VikunjaResponseError && (error.status === 400 || error.status === 404)
+}
