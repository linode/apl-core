diff --git a/src/operators/vikunja/lib/keycloak-groups.ts b/src/operators/vikunja/lib/keycloak-groups.ts
new file mode 100644
index 0000000..287fae3
--- /dev/null
+++ b/src/operators/vikunja/lib/keycloak-groups.ts
@@ -0,0 +1,73 @@
+/**
+ * Reads platform team membership out of Keycloak.
+ *
+ * Vikunja's own OIDC team sync is not usable here: teams it creates from a claim are not
+ * editable through the API, so the two mechanisms are mutually exclusive. Membership is
+ * therefore pushed, and Keycloak is the platform's source of truth for who is in a team --
+ * the same groups apl-keycloak-operator maintains.
+ *
+ * The connection is a master-realm `admin-cli` password grant, exactly as
+ * `src/operators/keycloak/keycloak.ts` does it.
+ */
+export const keycloakRealm = 'otomi'
+
+export interface KeycloakCredentials {
+  baseUrl: string
+  adminUsername: string
+  adminPassword: string
+}
+
+async function getAdminToken(creds: KeycloakCredentials): Promise<string> {
+  const res = await fetch(`${creds.baseUrl.replace(/\/$/, '')}/realms/master/protocol/openid-connect/token`, {
+    method: 'POST',
+    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
+    body: new URLSearchParams({
+      grant_type: 'password',
+      client_id: 'admin-cli',
+      username: creds.adminUsername,
+      password: creds.adminPassword,
+    }),
+  })
+  if (!res.ok) throw new Error(`Keycloak token request failed: ${res.status} ${res.statusText}`)
+  const body = (await res.json()) as { access_token?: string }
+  if (!body.access_token) throw new Error('Keycloak token request returned no access_token')
+  return body.access_token
+}
+
+async function get<T>(creds: KeycloakCredentials, token: string, path: string): Promise<T> {
+  const res = await fetch(`${creds.baseUrl.replace(/\/$/, '')}${path}`, {
+    headers: { Authorization: `Bearer ${token}` },
+  })
+  if (!res.ok) throw new Error(`Keycloak GET ${path} failed: ${res.status} ${res.statusText}`)
+  return (await res.json()) as T
+}
+
+/**
+ * Returns a map of group name to the usernames in it, for the given group names only.
+ * Groups that do not exist yet are simply absent from the result.
+ */
+export async function getGroupMemberships(
+  creds: KeycloakCredentials,
+  groupNames: string[],
+): Promise<Record<string, string[]>> {
+  if (groupNames.length === 0) return {}
+  const token = await getAdminToken(creds)
+  const groups = await get<Array<{ id: string; name: string }>>(
+    creds,
+    token,
+    `/admin/realms/${keycloakRealm}/groups?briefRepresentation=true&max=1000`,
+  )
+
+  const result: Record<string, string[]> = {}
+  for (const name of groupNames) {
+    const group = groups.find((g) => g.name === name)
+    if (!group) continue
+    const members = await get<Array<{ username?: string }>>(
+      creds,
+      token,
+      `/admin/realms/${keycloakRealm}/groups/${group.id}/members?max=1000`,
+    )
+    result[name] = members.map((m) => m.username).filter((u): u is string => !!u)
+  }
+  return result
+}
diff --git a/src/operators/vikunja/lib/managers/vikunja-projects.ts b/src/operators/vikunja/lib/managers/vikunja-projects.ts
new file mode 100644
index 0000000..10095e5
--- /dev/null
+++ b/src/operators/vikunja/lib/managers/vikunja-projects.ts
@@ -0,0 +1,74 @@
+import { VikunjaClient } from '../client'
+import { errors } from '../globals'
+import { VikunjaProject } from '../types/projects'
+import { VikunjaTeam } from '../types/teams'
+
+export const projectTitle = (teamId: string): string => `team-${teamId}`
+
+// Read & Write. Sharing at the team level gives every member of the team the same permission --
+// Vikunja's project<->team relation carries one permission, not one per member (see
+// `models.TeamProject`) -- so this is a deliberate simplification, not a limitation of the
+// operator. A platform that needs PO/Developer-style per-role permissions on the project itself
+// would need two Vikunja teams per platform team instead of one.
+const TEAM_PROJECT_PERMISSION = 1
+
+/**
+ * Creates the Vikunja project for every platform team, one project per team, named to match its
+ * team (`team-<id>`). Existing projects are left alone -- same idempotency shape as
+ * `upsertTeams`, so this is safe to call every reconcile.
+ */
+export async function upsertProjects(client: VikunjaClient, teamIds: string[]): Promise<Map<string, VikunjaProject>> {
+  const byTitle = new Map<string, VikunjaProject>()
+  let existing: VikunjaProject[]
+  try {
+    console.info('Getting all Vikunja projects')
+    existing = await client.listProjects()
+  } catch (e) {
+    errors.push(`Error getting all Vikunja projects: ${e}`)
+    return byTitle
+  }
+  for (const project of existing) byTitle.set(project.title, project)
+
+  for (const teamId of teamIds) {
+    const title = projectTitle(teamId)
+    if (byTitle.has(title)) continue
+    try {
+      console.info(`Creating Vikunja project "${title}"`)
+      const created = await client.createProject({ title, description: `Demo project for team ${teamId}` })
+      byTitle.set(title, created)
+    } catch (e) {
+      errors.push(`Error creating Vikunja project "${title}": ${e}`)
+    }
+  }
+  return byTitle
+}
+
+/**
+ * Ensures a project is shared with its matching team at `TEAM_PROJECT_PERMISSION`. Idempotent --
+ * re-reads the project's current team shares first and does nothing if already correct, the same
+ * "check before write" shape every other manager in this operator uses.
+ */
+export async function ensureProjectSharedWithTeam(
+  client: VikunjaClient,
+  project: VikunjaProject,
+  team: VikunjaTeam,
+): Promise<void> {
+  if (!project.id || !team.id) return
+  let current: Awaited<ReturnType<VikunjaClient['listProjectTeams']>>
+  try {
+    current = await client.listProjectTeams(project.id)
+  } catch (e) {
+    errors.push(`Error reading teams shared with Vikunja project "${project.title}": ${e}`)
+    return
+  }
+  // `GET /projects/{id}/teams` embeds the shared team's own object -- its `id` is the team id,
+  // not a `team_id` field (that name is only used in the PUT request body). Confirmed live.
+  const alreadyShared = current.some((share) => share.id === team.id && share.permission === TEAM_PROJECT_PERMISSION)
+  if (alreadyShared) return
+  try {
+    console.info(`Sharing Vikunja project "${project.title}" with team "${team.name}"`)
+    await client.shareProjectWithTeam(project.id, team.id, TEAM_PROJECT_PERMISSION)
+  } catch (e) {
+    errors.push(`Error sharing Vikunja project "${project.title}" with team "${team.name}": ${e}`)
+  }
+}
diff --git a/src/operators/vikunja/lib/managers/vikunja-teams.ts b/src/operators/vikunja/lib/managers/vikunja-teams.ts
new file mode 100644
index 0000000..31b5d92
--- /dev/null
+++ b/src/operators/vikunja/lib/managers/vikunja-teams.ts
@@ -0,0 +1,135 @@
+import { isMissingOrDuplicateMember, VikunjaClient } from '../client'
+import { errors } from '../globals'
+import { VikunjaTeam } from '../types/teams'
+
+export const teamName = (teamId: string): string => `team-${teamId}`
+
+/**
+ * Creates the Vikunja team for every platform team. Existing teams are left alone --
+ * Vikunja has no "update team" need here, the name is the only thing the platform owns.
+ */
+export async function upsertTeams(client: VikunjaClient, teamIds: string[]): Promise<Map<string, VikunjaTeam>> {
+  const byName = new Map<string, VikunjaTeam>()
+  let existing: VikunjaTeam[]
+  try {
+    console.info('Getting all Vikunja teams')
+    existing = await client.listTeams()
+  } catch (e) {
+    errors.push(`Error getting all Vikunja teams: ${e}`)
+    return byName
+  }
+  for (const team of existing) byName.set(team.name, team)
+
+  for (const teamId of teamIds) {
+    const name = teamName(teamId)
+    if (byName.has(name)) continue
+    try {
+      console.info(`Creating Vikunja team "${name}"`)
+      const created = await client.createTeam({ name, description: `App Platform team ${teamId}` })
+      byName.set(name, created)
+    } catch (e) {
+      errors.push(`Error creating Vikunja team "${name}": ${e}`)
+    }
+  }
+  return byName
+}
+
+/**
+ * Reconciles the members of one Vikunja team against the usernames the platform expects.
+ *
+ * A user only exists in Vikunja after their first OIDC login, so `PUT /teams/{id}/members`
+ * fails for anyone who has not signed in yet. That is normal, not an error: the operator
+ * keeps running and the member is added on a later reconcile.
+ *
+ * `serviceAccount` is the platform's own local account. It owns every team it created and
+ * must never be removed, or the operator locks itself out of that team.
+ *
+ * `adminUsernames` are the members that should hold Vikunja's per-team admin flag (add/remove
+ * members, rename the team). Vikunja's instance-admin API is Pro-licensed and returns 404 here,
+ * so this flag is the only administrative lever available -- and it is genuinely scoped to a
+ * single team, which is exactly the shape of a platform team admin.
+ */
+export async function reconcileMembers(
+  client: VikunjaClient,
+  team: VikunjaTeam,
+  expectedUsernames: string[],
+  serviceAccount: string,
+  adminUsernames: Set<string> = new Set(),
+): Promise<void> {
+  if (!team.id) return
+  let current: VikunjaTeam
+  try {
+    current = await client.getTeam(team.id)
+  } catch (e) {
+    errors.push(`Error reading Vikunja team "${team.name}": ${e}`)
+    return
+  }
+  const currentUsernames = (current.members ?? []).map((m) => m.username)
+  const keep = new Set([...expectedUsernames, serviceAccount])
+
+  for (const username of expectedUsernames) {
+    if (currentUsernames.includes(username)) continue
+    try {
+      console.info(`Adding "${username}" to Vikunja team "${team.name}"`)
+      await client.addTeamMember(team.id, username)
+    } catch (e) {
+      if (isMissingOrDuplicateMember(e)) {
+        console.info(`"${username}" has not signed in to Vikunja yet, will retry on the next reconcile`)
+        continue
+      }
+      errors.push(`Error adding "${username}" to Vikunja team "${team.name}": ${e}`)
+    }
+  }
+
+  for (const username of currentUsernames) {
+    if (keep.has(username)) continue
+    try {
+      console.info(`Removing "${username}" from Vikunja team "${team.name}"`)
+      await client.removeTeamMember(team.id, username)
+    } catch (e) {
+      errors.push(`Error removing "${username}" from Vikunja team "${team.name}": ${e}`)
+    }
+  }
+
+  await reconcileAdmins(client, team, adminUsernames, serviceAccount)
+}
+
+/**
+ * Brings the per-team admin flag in line with `adminUsernames`.
+ *
+ * Re-reads the team rather than reusing the membership read above, because members added moments
+ * ago are absent from it and would never get their flag set until some later reconcile. A read
+ * failure skips the whole pass -- `toggleTeamMemberAdmin` inverts the current value, so acting on
+ * a guess is worse than not acting at all.
+ *
+ * The service account is skipped: it owns every team it created and is already admin there.
+ */
+async function reconcileAdmins(
+  client: VikunjaClient,
+  team: VikunjaTeam,
+  adminUsernames: Set<string>,
+  serviceAccount: string,
+): Promise<void> {
+  if (!team.id) return
+  let after: VikunjaTeam
+  try {
+    after = await client.getTeam(team.id)
+  } catch (e) {
+    errors.push(`Error re-reading Vikunja team "${team.name}" before setting admins: ${e}`)
+    return
+  }
+
+  for (const member of after.members ?? []) {
+    if (member.username === serviceAccount) continue
+    const shouldBeAdmin = adminUsernames.has(member.username)
+    if (Boolean(member.admin) === shouldBeAdmin) continue
+    try {
+      console.info(
+        `${shouldBeAdmin ? 'Granting' : 'Revoking'} admin for "${member.username}" on Vikunja team "${team.name}"`,
+      )
+      await client.toggleTeamMemberAdmin(team.id, member.username)
+    } catch (e) {
+      errors.push(`Error updating admin flag for "${member.username}" on Vikunja team "${team.name}": ${e}`)
+    }
+  }
+}
