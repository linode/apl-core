+}
+
+// The body PUT /projects/{id}/teams expects to create a share.
+export interface VikunjaTeamProjectShareRequest {
+  team_id: number
+  permission: number
+}
+
+// What GET /projects/{id}/teams actually returns: the shared team's own object (its own `id`,
+// not `team_id`), with the share's `permission` folded in as an extra field. Confirmed live
+// against Vikunja 2.5.0 -- the read and write shapes are not the same DTO.
+export interface VikunjaTeamProjectShare {
+  id: number
+  name: string
+  permission: number
+}
