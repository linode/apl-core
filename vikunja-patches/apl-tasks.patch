+import dotenv from 'dotenv'
+import { cleanEnv, num, str } from 'envalid'
+
+export const VIKUNJA_URL = str({ desc: 'The vikunja service url' })
+export const VIKUNJA_URL_PORT = str({ desc: 'The vikunja service url port' })
+export const VIKUNJA_OPERATOR_NAMESPACE = str({ desc: 'The vikunja operator namespace' })
+export const RETRIES = num({ desc: 'The maximum amount of times to retry a certain function', default: 20 })
+export const MIN_TIMEOUT = num({ desc: 'The number of milliseconds before starting the first retry', default: 30000 })
+export const VIKUNJA_RECONCILE_INTERVAL = num({ desc: 'Reconciliation interval in seconds', default: 60 })
+
+export const vikunjaEnvValidators = {
+  VIKUNJA_URL,
+  VIKUNJA_URL_PORT,
+  VIKUNJA_OPERATOR_NAMESPACE,
+  RETRIES,
+  MIN_TIMEOUT,
+  VIKUNJA_RECONCILE_INTERVAL,
+}
+
+dotenv.config()
+export const vikunjaEnv = cleanEnv(process.env, vikunjaEnvValidators)
