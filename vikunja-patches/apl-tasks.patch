diff --git a/src/operators/vikunja/vikunja.ts b/src/operators/vikunja/vikunja.ts
new file mode 100644
index 0000000..5713030
--- /dev/null
+++ b/src/operators/vikunja/vikunja.ts
@@ -0,0 +1,235 @@
+/* eslint-disable no-console */
+import Operator, { ResourceEventType } from '@linode/apl-k8s-operator'
+import retry from 'async-retry'
+import { keys } from 'lodash'
+import { VikunjaClient } from './lib/client'
+import { vikunjaEnv } from './lib/env'
+import { errors } from './lib/globals'
+import { getGroupMemberships, KeycloakCredentials } from './lib/keycloak-groups'
+
+// Keycloak group names the platform maintains, alongside one `team-<id>` per team. See
+// apl-tasks src/tasks/keycloak/realm-factory.ts, which creates exactly these three.
+const PLATFORM_ADMIN_GROUP = 'platform-admin'
+const ALL_TEAMS_ADMIN_GROUP = 'all-teams-admin'
+const TEAM_ADMIN_GROUP = 'team-admin'
+import { reconcileMembers, teamName, upsertTeams } from './lib/managers/vikunja-teams'
+import { ensureProjectSharedWithTeam, projectTitle, upsertProjects } from './lib/managers/vikunja-projects'
+
+const VIKUNJA_ENDPOINT = `${vikunjaEnv.VIKUNJA_URL}:${vikunjaEnv.VIKUNJA_URL_PORT}`
+
+export type VikunjaConfig = {
+  vikunjaUsername: string
+  vikunjaPassword: string
+  keycloakAdmin: string
+  keycloakAdminPassword: string
+  keycloakUrl: string
+  teamConfig: Record<string, unknown>
+  teamNames: string[]
+  domainSuffix: string
+}
+
+const env: VikunjaConfig = {
+  vikunjaUsername: '',
+  vikunjaPassword: '',
+  keycloakAdmin: '',
+  keycloakAdminPassword: '',
+  keycloakUrl: '',
+  teamConfig: {},
+  teamNames: [],
+  domainSuffix: '',
+}
+
+const decode = (value: string | undefined): string => (value ? Buffer.from(value, 'base64').toString() : '')
+
+let reconciling = false
+let reconcileTimer: ReturnType<typeof setInterval> | null = null
+
+/**
+ * Runs setupVikunja, skipping the cycle if one is already in flight.
+ *
+ * The two callers are independent -- the resource watches below and the interval timer -- so
+ * without this guard a slow Keycloak round trip could have two reconciles pushing the same team
+ * membership at the same time. Modelled on the Harbor operator (`operators/harbor/harbor.ts`).
+ */
+async function reconcile(trigger: string): Promise<void> {
+  if (!env.vikunjaUsername || !env.vikunjaPassword || !env.keycloakAdminPassword || !env.keycloakUrl) {
+    // The timer can fire before the watches have delivered the secret and configmap.
+    console.info(`Missing required variables for Vikunja setup/reconfiguration (trigger: ${trigger})`)
+    return
+  }
+  if (reconciling) {
+    console.info(`Reconciliation already in progress, skipping this cycle (trigger: ${trigger})`)
+    return
+  }
+  reconciling = true
+  try {
+    await setupVikunja()
+  } catch (error) {
+    console.debug('Error could not run setup vikunja', error)
+  } finally {
+    reconciling = false
+  }
+}
+
+const secretsAndConfigmapsCallback = async (e: any) => {
+  const { object } = e
+  const { metadata, data } = object
+
+  if (object.kind === 'Secret' && metadata.name === 'apl-vikunja-operator-secret') {
+    env.vikunjaUsername = decode(data.vikunjaUsername)
+    env.vikunjaPassword = decode(data.vikunjaPassword)
+    env.keycloakAdmin = decode(data.keycloakAdmin)
+    env.keycloakAdminPassword = decode(data.keycloakAdminPassword)
+    env.keycloakUrl = decode(data.keycloakUrl)
+  } else if (object.kind === 'ConfigMap' && metadata.name === 'apl-vikunja-operator-cm') {
+    env.teamConfig = JSON.parse(data.teamConfig)
+    env.teamNames = keys(env.teamConfig)
+    env.domainSuffix = data.domainSuffix
+  }
+
+  if (!env.vikunjaUsername || !env.vikunjaPassword || !env.keycloakAdminPassword || !env.keycloakUrl) {
+    console.info('Missing required variables for Vikunja setup/reconfiguration')
+    return
+  }
+
+  switch (e.type) {
+    case ResourceEventType.Added:
+    case ResourceEventType.Modified: {
+      await reconcile(`${object.kind}/${metadata.name}`)
+      break
+    }
+    default:
+      break
+  }
+}
+
+export default class MyOperator extends Operator {
+  protected async init() {
+    await this.waitForVikunjaAvailability()
+
+    try {
+      await this.watchResource('', 'v1', 'secrets', secretsAndConfigmapsCallback, vikunjaEnv.VIKUNJA_OPERATOR_NAMESPACE)
+    } catch (error) {
+      console.debug('Error could not watch secrets', error)
+    }
+    try {
+      await this.watchResource(
+        '',
+        'v1',
+        'configmaps',
+        secretsAndConfigmapsCallback,
+        vikunjaEnv.VIKUNJA_OPERATOR_NAMESPACE,
+      )
+    } catch (error) {
+      console.debug('Error could not watch configmaps', error)
+    }
+
+    // Team membership depends on two things Kubernetes emits no event for: a user joining the
+    // Keycloak group, and that user's first login to Vikunja (a member cannot be added before
+    // the account exists). The watches above therefore cannot converge membership on their own --
+    // only a timer can. Same approach as the Harbor operator.
+    console.info(`Reconciling every ${vikunjaEnv.VIKUNJA_RECONCILE_INTERVAL}s`)
+    reconcileTimer = setInterval(() => {
+      void reconcile('interval')
+    }, vikunjaEnv.VIKUNJA_RECONCILE_INTERVAL * 1000)
+  }
+
+  private async waitForVikunjaAvailability(): Promise<void> {
+    console.info('Waiting for Vikunja to be available...')
+    await retry(
+      async () => {
+        const client = new VikunjaClient(VIKUNJA_ENDPOINT, '', '')
+        const info = await client.info()
+        console.info(`Vikunja API is available, version: ${info.version ?? 'unknown'}`)
+      },
+      {
+        retries: 30,
+        minTimeout: 10000,
+        maxTimeout: 10000,
+        onRetry: (_error, attempt) => {
+          console.debug(`Vikunja availability check failed (attempt ${attempt}/30), retrying...`)
+        },
+      },
+    )
+  }
+}
+
+async function setupVikunja(): Promise<void> {
+  console.info('Starting Vikunja setup/reconfiguration')
+  errors.length = 0
+
+  const client = new VikunjaClient(VIKUNJA_ENDPOINT, env.vikunjaUsername, env.vikunjaPassword)
+  await client.login()
+
+  const teamsByName = await upsertTeams(client, env.teamNames)
+  const projectsByTitle = await upsertProjects(client, env.teamNames)
+
+  const credentials: KeycloakCredentials = {
+    baseUrl: env.keycloakUrl,
+    adminUsername: env.keycloakAdmin,
+    adminPassword: env.keycloakAdminPassword,
+  }
+  let memberships: Record<string, string[]> = {}
+  try {
+    memberships = await getGroupMemberships(credentials, [
+      ...env.teamNames.map((id) => teamName(id)),
+      PLATFORM_ADMIN_GROUP,
+      ALL_TEAMS_ADMIN_GROUP,
+      TEAM_ADMIN_GROUP,
+    ])
+  } catch (error) {
+    // Without Keycloak the teams still exist; only membership goes stale.
+    errors.push(`Error reading team membership from Keycloak: ${error}`)
+  }
+
+  // platform-admin and all-teams-admin are the platform's two global tiers -- apl-api treats both
+  // as platform admins, and Harbor gives all-teams-admin projectAdmin on EVERY project. Vikunja
+  // has no instance-admin API (Pro-licensed, 404 here), so admin of every team is the faithful
+  // equivalent: they join each team and hold its admin flag.
+  const globalAdmins = new Set([
+    ...(memberships[PLATFORM_ADMIN_GROUP] ?? []),
+    ...(memberships[ALL_TEAMS_ADMIN_GROUP] ?? []),
+  ])
+  // team-admin is a single global marker (isTeamAdmin on the user), not a per-team role -- there
+  // is no team-<id>-admin group anywhere in the platform. Intersecting it with actual membership
+  // is what scopes it: a team admin gets the admin flag on the teams they are in, and nothing at
+  // all on the teams they are not.
+  const teamAdmins = new Set(memberships[TEAM_ADMIN_GROUP] ?? [])
+
+  for (const teamId of env.teamNames) {
+    const name = teamName(teamId)
+    const team = teamsByName.get(name)
+    if (!team) continue
+    const teamMembers = memberships[name] ?? []
+    const expected = [...new Set([...teamMembers, ...globalAdmins])]
+    const admins = new Set<string>(globalAdmins)
+    for (const username of teamMembers) if (teamAdmins.has(username)) admins.add(username)
+    await reconcileMembers(client, team, expected, env.vikunjaUsername, admins)
+
+    const project = projectsByTitle.get(projectTitle(teamId))
+    if (project) await ensureProjectSharedWithTeam(client, project, team)
+  }
+
+  if (errors.length) {
+    console.error(`Errors found: ${JSON.stringify(errors, null, 2)}`)
+  } else {
+    console.info('Success! Vikunja setup/reconfiguration completed')
+  }
+}
+
+async function main(): Promise<void> {
+  const operator = new MyOperator()
+  console.info('Listening to secrets and configmaps')
+  await operator.start()
+  const exit = () => {
+    if (reconcileTimer) clearInterval(reconcileTimer)
+    operator.stop()
+    process.exit(0)
+  }
+
+  process.on('SIGTERM', exit).on('SIGINT', exit)
+}
+
+if (typeof require !== 'undefined' && require.main === module) {
+  void main()
+}
