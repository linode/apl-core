{{- $v := .Values }}
{{- $d := $v.apps | get "dex" }}
{{- $httpRoute := tpl (readFile "../../helmfile.d/snippets/routes.gotmpl") $v | fromYaml }}

{{- /*
  PRE-RELEASE IMAGE. APL must not be released while this is pinned to a build from Dex's master
  branch. Two features are needed and only one has shipped:

    - groups on local passwords: released in 2.45.0. Chart 0.24.1 still ships 2.44.0, which drops
      the groups field at login, and group membership drives all platform authorization.
    - auth sessions and RP-initiated logout: merged on master, unreleased (dexidp/dex#4560).
      Without them Dex holds no browser session, so applications running their own OIDC flow
      prompt for credentials again and there is no end-session endpoint.

  Pinned by digest rather than the floating `master` tag so the running version cannot change
  underneath a cluster. Replace with the first Dex release that contains dexidp/dex#4560.
*/}}
image:
  tag: master
  digest: sha256:af9469509350ff3f6ca70127175a58e5ab085b9d18740fa4a590d9f03f0a026b
#  TODO add dex to ORCS
#  {{- if $v.otomi.linodeLkeImageRepository }}
#  repository: {{ $v.otomi.linodeLkeImageRepository }}/ghcr/dexidp/dex
#  {{- end }}

{{- /* Auth sessions are behind a feature flag while unreleased. */}}
env:
  DEX_SESSIONS_ENABLED: "true"

{{- with $v.otomi | get "globalPullSecret" nil }}
imagePullSecrets:
  - name: otomi-pullsecret-global
{{- end }}

replicaCount: {{ $d.replicas }}

# The Dex configuration is delivered as an ExternalSecret (see dex-raw.gotmpl) because it
# contains the OAuth2 client secret. Secret values must never travel through Helmfile values.
configSecret:
  create: false
  name: dex-config

# Dex stores auth codes, refresh tokens, offline sessions, passwords and signing keys as
# custom resources, so it needs permission to manage them and to register its own CRDs.
rbac:
  create: true
  createClusterScoped: true

serviceAccount:
  create: true

httpRoute:
  enabled: true
  {{- with $httpRoute.annotations }}
  annotations:
    {{- . | toYaml | nindent 4 }}
  {{- end }}
  parentRefs:
    {{- $httpRoute.parentRefs | toYaml | nindent 4 }}
  hostnames:
    - {{ $v._derived.dexDomain }}

service:
  ports:
    http:
      port: 5556

resources: {{- toYaml $d.resources | nindent 2 }}

priorityClassName: otomi-critical
