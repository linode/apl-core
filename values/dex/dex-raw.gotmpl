{{- $v := .Values }}
{{- $d := $v.apps | get "dex" }}
{{- $o := $v | get "oidc" dict }}
{{- $domainSuffix := $v.cluster.domainSuffix }}

{{- /*
  Redirect URIs for the shared platform client. Mirrors how the Keycloak operator builds its
  redirect list, so switching issuer does not change which URLs are accepted.
*/}}
{{- $teamIds := list }}
{{- range $name, $team := omit $v.teamConfig "admin" }}
{{- $teamIds = append $teamIds $name }}
{{- end }}
{{- $teamIds = sortAlpha $teamIds }}
{{- $redirectUrls := list }}
{{- range $coreApp := $v.adminApps }}
  {{- if $coreApp | get "ownHost" false }}
    {{- $redirectUrls = append $redirectUrls (printf "https://%s.%s/*" $coreApp.name $domainSuffix) }}
  {{- end }}
{{- end }}
{{- range $teamApp := $v.teamApps }}
  {{- if $teamApp | get "ownHost" false }}
    {{- range $teamId := $teamIds }}
      {{- $redirectUrls = append $redirectUrls (printf "https://%s-%s.%s/*" $teamApp.name $teamId $domainSuffix) }}
    {{- end }}
  {{- end }}
{{- end }}
{{- $redirectUrls = sortAlpha $redirectUrls }}

resources:
  - {{ tpl (readFile "../../helmfile.d/snippets/serviceentry.gotmpl") (dict "name" "dex" "host" $v._derived.dexDomain) | nindent 4 }}

  {{- /*
    The whole Dex configuration is assembled here rather than in dex.gotmpl because it embeds
    the OAuth2 client secret. Consumers read the same secret through the derived store
    coordinates, so every application shares one client with the active issuer.
  */}}
  - apiVersion: external-secrets.io/v1
    kind: ExternalSecret
    metadata:
      name: dex-config
      namespace: dex
    spec:
      refreshInterval: 5m
      secretStoreRef:
        name: core-secrets-store
        kind: ClusterSecretStore
      target:
        name: dex-config
        creationPolicy: Owner
        template:
          type: Opaque
          data:
            config.yaml: |
              issuer: https://{{ $v._derived.dexDomain }}
              storage:
                type: kubernetes
                config:
                  inCluster: true
              web:
                http: 0.0.0.0:5556
              telemetry:
                http: 0.0.0.0:5558
              oauth2:
                skipApprovalScreen: true
              enablePasswordDB: true
              {{- /*
                Seeds the platform admin as a static password so someone can log in before any
                user projection exists. Static passwords are read once at startup and cannot be
                changed at runtime, so this is a bootstrap credential only. Real users become
                Password custom resources, which Dex reads live from storage.
              */}}
              staticPasswords:
                - email: {{ $d.adminUsername }}@{{ $domainSuffix }}
                  username: {{ $d.adminUsername }}
                  userID: apl-platform-admin
                  hash: '{{ "{{ .adminPasswordHash | toString }}" }}'
                  groups:
                    - platform-admin
                    - admin
              staticClients:
                - id: {{ $d.idp.clientID }}
                  name: APL
                  secret: '{{ "{{ .idpClientSecret | toString }}" }}'
                  redirectURIs:
                    {{- range $url := $redirectUrls }}
                    - {{ $url }}
                    {{- end }}
              {{- if $v.otomi.hasExternalIDP }}
              connectors:
                - type: oidc
                  id: {{ $o | get "alias" "upstream" }}
                  name: {{ $o | get "alias" "upstream" }}
                  config:
                    issuer: {{ $o.issuer }}
                    clientID: '{{ "{{ .oidcClientID | toString }}" }}'
                    clientSecret: '{{ "{{ .oidcClientSecret | toString }}" }}'
                    redirectURI: https://{{ $v._derived.dexDomain }}/callback
                    userIDKey: {{ $o | get "subClaimMapper" "sub" }}
                    scopes:
                      - openid
                      - profile
                      - email
                      - groups
                    insecureSkipEmailVerified: true
              {{- end }}
      data:
        - secretKey: idpClientSecret
          remoteRef:
            key: {{ $v._derived.oidcClientSecretKey }}
            property: {{ $v._derived.oidcClientSecretProperty }}
        - secretKey: adminPasswordHash
          remoteRef:
            key: dex-secrets
            property: adminPasswordHash
        {{- if $v.otomi.hasExternalIDP }}
        - secretKey: oidcClientID
          remoteRef:
            key: oidc-secrets
            property: clientID
        - secretKey: oidcClientSecret
          remoteRef:
            key: oidc-secrets
            property: clientSecret
        {{- end }}
