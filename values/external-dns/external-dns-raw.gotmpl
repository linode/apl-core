{{- end }}

{{- if hasKey $d.provider "google" }}
resources:
- apiVersion: external-secrets.io/v1
  kind: ExternalSecret
  metadata:
    name: google-dns
  spec:
    refreshInterval: 5m
    secretStoreRef:
      name: core-secrets-store
      kind: ClusterSecretStore
    target:
      name: google-dns
      creationPolicy: Owner
      template:
        type: Opaque
        data:
          GOOGLE_APPLICATION_CREDENTIALS: '{{ "{{ .serviceAccountKey | toString }}" }}'
    data:
      - secretKey: serviceAccountKey
        remoteRef:
          key: dns-secrets
