{{- $v := .Values }}
{{- $d := $v.dns}}

{{- if hasKey $d.provider "akamai" }}
resources:
- apiVersion: external-secrets.io/v1
  kind: ExternalSecret
  metadata:
    name: akamai-dns
  spec:
    refreshInterval: 5m
    secretStoreRef:
      name: core-secrets-store
      kind: ClusterSecretStore
    target:
      name: akamai-dns
      creationPolicy: Owner
    data:
      - secretKey: EXTERNAL_DNS_AKAMAI_CLIENT_SECRET
        remoteRef:
          key: dns-secrets
          property: provider_akamai_clientSecret
      - secretKey: EXTERNAL_DNS_AKAMAI_CLIENT_TOKEN
        remoteRef:
          key: dns-secrets
          property: provider_akamai_clientToken
      - secretKey: EXTERNAL_DNS_AKAMAI_ACCESS_TOKEN
        remoteRef:
          key: dns-secrets
          property: provider_akamai_accessToken
{{- end }}

{{- if hasKey $d.provider "linode" }}
resources:
- apiVersion: external-secrets.io/v1
  kind: ExternalSecret
  metadata:
    name: linode-dns-api-token
  spec:
    refreshInterval: 5m
    secretStoreRef:
      name: core-secrets-store
      kind: ClusterSecretStore
    target:
      name: linode-dns-api-token
      creationPolicy: Owner
    data:
      - secretKey: LINODE_TOKEN
        remoteRef:
          key: dns-secrets
          property: provider_linode_apiToken
{{- end }}

{{- if hasKey $d.provider "digitalocean" }}
resources:
- apiVersion: external-secrets.io/v1
  kind: ExternalSecret
  metadata:
    name: do-token
  spec:
    refreshInterval: 5m
    secretStoreRef:
      name: core-secrets-store
      kind: ClusterSecretStore
    target:
      name: do-token
      creationPolicy: Owner
    data:
      - secretKey: DO_TOKEN
        remoteRef:
          key: dns-secrets
          property: provider_digitalocean_apiToken
{{- end }}

{{- if hasKey $d.provider "cloudflare" }}
  {{- $provider := index $d.provider "cloudflare" }}
  {{- if hasKey $provider "email" }}
resources:
- apiVersion: external-secrets.io/v1
  kind: ExternalSecret
  metadata:
    name: cloudflare-api-key
  spec:
    refreshInterval: 5m
    secretStoreRef:
      name: core-secrets-store
      kind: ClusterSecretStore
    target:
      name: cloudflare-api-key
      creationPolicy: Owner
      template:
        type: Opaque
        data:
          CF_API_KEY: "{{ `{{ .apiSecret }}` }}"
          CF_API_EMAIL: {{ $provider.email | quote }}
    data:
      - secretKey: apiSecret
        remoteRef:
          key: dns-secrets
          property: provider_cloudflare_apiSecret
  {{- else }}
resources:
- apiVersion: external-secrets.io/v1
  kind: ExternalSecret
  metadata:
    name: cloudflare-api-key
  spec:
    refreshInterval: 5m
    secretStoreRef:
      name: core-secrets-store
      kind: ClusterSecretStore
    target:
      name: cloudflare-api-key
      creationPolicy: Owner
    data:
      - secretKey: CF_API_TOKEN
        remoteRef:
          key: dns-secrets
          property: provider_cloudflare_apiToken
  {{- end }}
{{- end }}

{{- if hasKey $d.provider "aws" }}
  {{- $provider := index $d.provider "aws" }}
resources:
- apiVersion: external-secrets.io/v1
  kind: ExternalSecret
  metadata:
    name: aws-dns-credentials
  spec:
    refreshInterval: 5m
    secretStoreRef:
      name: core-secrets-store
      kind: ClusterSecretStore
    target:
      name: aws-dns-credentials
      creationPolicy: Owner
    data:
      - secretKey: AWS_ACCESS_KEY_ID
        remoteRef:
          key: dns-secrets
          property: provider_aws_credentials_accessKey
      - secretKey: AWS_SECRET_ACCESS_KEY
        remoteRef:
          key: dns-secrets
          property: provider_aws_credentials_secretKey
{{- end }}

{{- if hasKey $d.provider "azure" }}
{{- $provider := index $d.provider "azure" }}
resources:
- apiVersion: external-secrets.io/v1
  kind: ExternalSecret
  metadata:
    name: azure-dns
  spec:
    refreshInterval: 5m
    secretStoreRef:
      name: core-secrets-store
      kind: ClusterSecretStore
    target:
      name: azure-dns
      creationPolicy: Owner
      template:
        type: Opaque
        data:
          AZURE_TENANT_ID: {{ $provider.tenantId | quote }}
          AZURE_SUBSCRIPTION_ID: {{ $provider.subscriptionId | quote }}
          AZURE_RESOURCE_GROUP: {{ $provider.resourceGroup | quote }}
          AZURE_CLIENT_ID: {{ $provider.aadClientId | quote }}
          AZURE_CLIENT_SECRET: "{{ `{{ .aadClientSecret }}` }}"
    data:
      - secretKey: aadClientSecret
        remoteRef:
          key: dns-secrets
          property: provider_azure_aadClientSecret
{{- end }}

{{- if hasKey $d.provider "azure-private-dns" }}
{{- $provider := index $d.provider "azure-private-dns" }}
resources:
- apiVersion: external-secrets.io/v1
  kind: ExternalSecret
  metadata:
    name: azure-private-dns
  spec:
    refreshInterval: 5m
    secretStoreRef:
      name: core-secrets-store
      kind: ClusterSecretStore
    target:
      name: azure-private-dns
      creationPolicy: Owner
      template:
        type: Opaque
        data:
          AZURE_TENANT_ID: {{ $provider.tenantId | quote }}
          AZURE_SUBSCRIPTION_ID: {{ $provider.subscriptionId | quote }}
          AZURE_RESOURCE_GROUP: {{ $provider.resourceGroup | quote }}
          AZURE_CLIENT_ID: {{ $provider.aadClientId | quote }}
          AZURE_CLIENT_SECRET: "{{ `{{ .aadClientSecret }}` }}"
    data:
      - secretKey: aadClientSecret
        remoteRef:
          key: dns-secrets
          property: provider_azure-private-dns_aadClientSecret
{{- end }}

{{- if hasKey $d.provider "google" }}
resources:
- apiVersion: external-secrets.io/v1
  kind: ExternalSecret
  metadata:
    name: google-dns
  spec:
    refreshInterval: 5m
    secretStoreRef:
      name: core-secrets-store
      kind: ClusterSecretStore
    target:
      name: google-dns
      creationPolicy: Owner
    data:
      - secretKey: GOOGLE_APPLICATION_CREDENTIALS
        remoteRef:
          key: dns-secrets
          property: provider_google_serviceAccountKey
{{- end }}
