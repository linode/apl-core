{{- $v := .Values }}
{{- $g := $v.apps.gitea }}
{{- $kms := $v | get "kms" dict }}


kms: {{- $kms | toYaml | nindent 2 }}

giteaPassword: {{ $g.adminPassword | quote }}
{{- /* coreImageRepository is the full reference and wins; linodeLkeImageRepository appends the path. */ -}}
{{- $repository := $v.otomi | get "coreImageRepository" nil }}
{{- if not $repository }}
  {{- with $v.otomi | get "linodeLkeImageRepository" nil }}
    {{- $repository = printf "%s/docker/linode/apl-core" . }}
  {{- end }}
{{- end }}
core:
  image:
    {{- with $repository }}
    repository: "{{ . }}"
    {{- end }}
    tag: {{ $v.otomi.version }}
cloneUnsecure: true


tektonTask:
  resources:
    # Tekton Task pod resouce limits and requests
    requests:
      cpu: '50m'
    limits:
      cpu: '2'
