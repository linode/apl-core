{{- $v := .Values }}
{{- $kv := $v.apps.kyverno }}

crds:
  # Do not use Helm subchart, but statically-rendered CRDs
  install: false

upgrade:
  # All APL policies are migrated to policies.kyverno.io (CEL) types. The legacy kyverno.io
  # Policy/ClusterPolicy objects are pruned by ArgoCD when team-ns and kyverno-artifacts sync,
  # which happens after kyverno itself. Acknowledge so the legacy check hook does not block that upgrade.
  acknowledgeLegacyPoliciesNotEnforced: true

global:
  nodeSelector: {{- toYaml $v.otomi.nodeSelector | nindent 4 }}
  {{- with $v.otomi.linodeLkeImageRepository }}
  image:
    registry: {{ . }}/ghcr
  {{- end }}

admissionController:
  {{- if eq $kv.mode "DevTest" }}
  replicas: 1
  {{- else if eq $kv.mode "Prod" }}
  replicas: 3
  {{- end }}
  initContainer:
    resources:
      limits:
        cpu: 1
  serviceMonitor:
    enabled: true
    additionalLabels:
      prometheus: system
  container:
    resources: {{- $kv.resources.admissionController | toYaml | nindent 6 }}
  nodeSelector: {{- toYaml $v.otomi.nodeSelector | nindent 4 }}

cleanupController:
  {{- if eq $kv.mode "DevTest" }}
  replicas: 1
  {{- else if eq $kv.mode "Prod" }}
  replicas: 3
  {{- end }}
  resources: {{- $kv.resources.cleanupController | toYaml | nindent 4 }}
  nodeSelector: {{- toYaml $v.otomi.nodeSelector | nindent 4 }}

backgroundController:
  {{- if eq $kv.mode "DevTest" }}
  replicas: 1
  {{- else if eq $kv.mode "Prod" }}
  replicas: 2
  {{- end }}
  resources: {{- $kv.resources.backgroundController | toYaml | nindent 4 }}
  nodeSelector: {{- toYaml $v.otomi.nodeSelector | nindent 4 }}
  serviceMonitor:
    enabled: true
    additionalLabels:
      prometheus: system

reportsController:
  {{- if eq $kv.mode "DevTest" }}
  replicas: 1
  {{- else if eq $kv.mode "Prod" }}
  replicas: 2
  {{- end }}
  resources: {{- $kv.resources.reportsController | toYaml | nindent 4 }}
  nodeSelector: {{- toYaml $v.otomi.nodeSelector | nindent 4 }}

features:
  logging:
    # -- Logging format
    format: text
    # -- Logging verbosity
    # kyverno generates a lot of logs. Set to a higher value when required
    verbosity: 1

config:
  # -- Exclude Kyverno namespace
  # Determines if default Kyverno namespace exclusion is enabled for webhooks and resourceFilters
  # required for nodeAffinity (alse force kyverno to disired nodes)
  excludeKyvernoNamespace: true
