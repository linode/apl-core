{{- $v := .Values }}
{{- $k := $v.apps.vikunja }}
{{- $kc := $v.apps.keycloak }}
{{- $teamConfig := dict }}
{{- range $teamId, $team := $v.teamConfig }}
  {{- $_ := set $teamConfig $teamId dict }}
{{- end }}
{{- $teamConfig := $teamConfig | toJson }}

resources:
  - apiVersion: v1
    kind: ConfigMap
    metadata:
      name: apl-vikunja-operator-cm
      namespace: apl-vikunja-operator
    data:
      domainSuffix: "{{ $v.cluster.domainSuffix }}"
      teamConfig: {{ $teamConfig | toJson }}
  - apiVersion: external-secrets.io/v1
    kind: ExternalSecret
    metadata:
      name: apl-vikunja-operator-secret
      namespace: apl-vikunja-operator
    spec:
      refreshInterval: 1m
      secretStoreRef:
        name: core-secrets-store
        kind: ClusterSecretStore
      target:
        name: apl-vikunja-operator-secret
        creationPolicy: Owner
        template:
          type: Opaque
          data:
            vikunjaUsername: {{ $k.adminUsername }}
            vikunjaPassword: '{{ "{{ .vikunjaPassword | toString }}" }}'
            {{/* Membership is read from the Keycloak group of the same name as the
                 platform team -- see the apl-keycloak-operator secret for the same
                 admin credential and the same master-realm admin-cli grant. */}}
            keycloakAdmin: {{ $kc.adminUsername }}
            keycloakAdminPassword: '{{ "{{ .keycloakAdminPassword | toString }}" }}'
            {{/* The in-cluster service, not https://keycloak.<domain>: over the public
                 host the platform CA is untrusted and Node would need NODE_EXTRA_CA_CERTS.

                 The :8080 is load-bearing. The Service exposes 9000/8080/8443 and NOT 80,
                 so a port-less http:// URL resolves to :80 and every request hangs until
                 it hits the client's connect timeout -- surfacing as the near-contentless
                 `TypeError: fetch failed`, with the operator otherwise Running and happily
                 talking to Vikunja. Matches $oidcBaseUrlBackchannel in
                 helmfile.d/snippets/derived.gotmpl, which is the platform's canonical
                 backchannel address.

                 Note apl-keycloak-operator's KEYCLOAK_ADDRESS_INTERNAL is written without
                 the port; this deliberately does not copy that. */}}
            keycloakUrl: http://keycloak-keycloakx-http.keycloak.svc.cluster.local:8080
      data:
        - secretKey: vikunjaPassword
          remoteRef:
            key: vikunja-secrets
            property: adminPassword
        - secretKey: keycloakAdminPassword
          remoteRef:
            key: otomi-secrets
            property: adminPassword
