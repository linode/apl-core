{{- $v := .Values }}
{{- $o:= $v.apps.otel }}

replicaCount: {{ $o.operator.replicaCount }}
nameOverride: otel-operator
imagePullSecrets: []
manager:
{{- with $v.otomi.linodeLkeImageRepository }}
  {{- $repoPrefix := print . "/ghcr/open-telemetry" }}
  image:
    repository: "{{ $repoPrefix }}/opentelemetry-operator/opentelemetry-operator"
  collectorImage:
    repository: "{{ $repoPrefix }}/opentelemetry-collector-releases/opentelemetry-collector-k8s"
  targetAllocatorImage:
    repository: "{{ $repoPrefix }}/opentelemetry-operator/target-allocator"
{{- end }}
  resources: {{- $o.resources.manager | toYaml | nindent 4 }}
  serviceMonitor:
    enabled: true
    extraLabels:
      prometheus: system
    metricsEndpoints:
      - port: metrics
  ports:
    metricsPort: 8080
  metrics:
    secure: false

nodeSelector: {{- toYaml $v.otomi.nodeSelector | nindent 2 }}
