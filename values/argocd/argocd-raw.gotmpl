{{- $v := .Values }}
{{- $a := $v.apps.argocd }}
resources:
{{- if $v._derived.untrustedCA }}
  - apiVersion: v1
    kind: Secret
    metadata:
      name: custom-ca
    data:
      custom-ca-certificates.crt: {{ .Values._derived.caCert | b64enc }}
{{- end }}
{{- if contains "gitea-http.gitea.svc.cluster.local" $v.otomi.git.repoUrl }}
  - apiVersion: external-secrets.io/v1
    kind: ExternalSecret
    metadata:
      name: argocd-repo-creds-gitea
      namespace: argocd
    spec:
      refreshInterval: 1m
      secretStoreRef:
        name: core-secrets-store
        kind: ClusterSecretStore
      target:
        name: argocd-repo-creds-gitea
        creationPolicy: Owner
        template:
          metadata:
            labels:
              argocd.argoproj.io/secret-type: repo-creds
          type: Opaque
          data:
            type: git
            url: {{ printf "https://%s" $v._derived.giteaDomain }}
            username: {{ $v.otomi.git.username }}
            password: '{{ "{{ .gitPassword | toString }}" }}'
      data:
        - secretKey: gitPassword
          remoteRef:
            key: apl-git-config
            property: password
  - apiVersion: external-secrets.io/v1
    kind: ExternalSecret
    metadata:
      name: argocd-repo-creds-gitea-internal
      namespace: argocd
    spec:
      refreshInterval: 1m
      secretStoreRef:
        name: core-secrets-store
        kind: ClusterSecretStore
      target:
        name: argocd-repo-creds-gitea-internal
        creationPolicy: Owner
        template:
          metadata:
            labels:
              argocd.argoproj.io/secret-type: repo-creds
          type: Opaque
          data:
            type: git
            url: {{ $v.otomi.git.repoUrl | quote }}
            username: {{ $v.otomi.git.username | quote }}
            password: '{{ "{{ .gitPassword | toString }}" }}'
      data:
        - secretKey: gitPassword
          remoteRef:
            key: apl-git-config
            property: password

{{- else if contains "git-server.git-server.svc.cluster.local" $v.otomi.git.repoUrl }}
  - apiVersion: external-secrets.io/v1
    kind: ExternalSecret
    metadata:
      name: argocd-repo-creds-git-server
      namespace: argocd
    spec:
      refreshInterval: 1m
      secretStoreRef:
        name: core-secrets-store
        kind: ClusterSecretStore
      target:
        name: argocd-repo-creds-git-server
        creationPolicy: Owner
        template:
          metadata:
            labels:
              argocd.argoproj.io/secret-type: repo-creds
          type: Opaque
          data:
            type: git
            url: {{ $v.otomi.git.repoUrl | quote }}
            username: {{ $v.otomi.git.username | quote }}
            password: '{{ "{{ .gitPassword | toString }}" }}'
      data:
        - secretKey: gitPassword
          remoteRef:
            key: apl-git-config
            property: password
{{- else }}
  - apiVersion: external-secrets.io/v1
    kind: ExternalSecret
    metadata:
      name: argocd-repo-creds-git
      namespace: argocd
    spec:
      refreshInterval: 1m
      secretStoreRef:
        name: core-secrets-store
        kind: ClusterSecretStore
      target:
        name: argocd-repo-creds-git
        creationPolicy: Owner
        template:
          metadata:
            labels:
              argocd.argoproj.io/secret-type: repo-creds
          type: Opaque
          data:
            type: git
            url: {{ $v.otomi.git.repoUrl | quote }}
            username: {{ $v.otomi.git.username | quote }}
            password: '{{ "{{ .gitPassword | toString }}" }}'
      data:
        - secretKey: gitPassword
          remoteRef:
            key: apl-git-config
            property: password
{{- end }}
  - apiVersion: external-secrets.io/v1
    kind: ExternalSecret
    metadata:
      name: argocd-oidc-secret
      namespace: argocd
    spec:
      refreshInterval: 5m
      secretStoreRef:
        name: core-secrets-store
        kind: ClusterSecretStore
      target:
        name: argocd-secret
        creationPolicy: Merge
        # Empty template stops ESO from copying this ExternalSecret's
        # argocd tracking-id annotation onto the shared argocd-secret
        template:
          mergePolicy: Merge
          metadata: {}
      data:
        - secretKey: oidc.clientSecret
          remoteRef:
            key: {{ $v._derived.oidcClientSecretKey }}
            property: {{ $v._derived.oidcClientSecretProperty }}
  - apiVersion: external-secrets.io/v1
    kind: ExternalSecret
    metadata:
      name: argocd-redis-secret
      namespace: argocd
    spec:
      refreshPolicy: CreatedOnce
      target:
        name: argocd-redis
        creationPolicy: Owner
        immutable: true
      dataFrom:
        - sourceRef:
            generatorRef:
              apiVersion: generators.external-secrets.io/v1alpha1
              kind: ClusterGenerator
              name: alpha-num-32
          rewrite:
            - regexp:
                source: password
                target: auth
  - apiVersion: v1
    kind: Secret
    metadata:
      name: argocd-repo-apl-core
      namespace: argocd
      labels:
        argocd.argoproj.io/secret-type: repository
    data:
      type: {{ print "git" | b64enc | quote }}
      url: {{ print "https://github.com/linode/apl-core.git" | b64enc | quote }}
      depth: {{ print "1" | b64enc | quote }}
      name: {{ print "apl-core" | b64enc | quote }}
      project: {{ print "default" | b64enc | quote }}
  - apiVersion: argoproj.io/v1alpha1
    kind: AppProject
    metadata:
      name: apl-addons
      namespace: argocd
    spec:
      sourceRepos:
        - '*'
      sourceNamespaces:
        - apl-addons
      destinations:
        - namespace: '*'
          server: '*'
      clusterResourceWhitelist:
        - group: '*'
          kind: '*'
      namespaceResourceBlacklist: []
  - apiVersion: admissionregistration.k8s.io/v1
    kind: ValidatingAdmissionPolicy
    metadata:
      name: protect-apl-addons-appproject
    spec:
      failurePolicy: Fail
      matchConstraints:
        resourceRules:
          - apiGroups:
              - argoproj.io
            apiVersions:
              - v1alpha1
            operations:
              - DELETE
            resources:
              - appprojects
      validations:
        - expression: "oldObject.metadata.name != 'apl-addons' || oldObject.metadata.namespace != 'argocd'"
          message: The apl-addons AppProject cannot be deleted.
  - apiVersion: admissionregistration.k8s.io/v1
    kind: ValidatingAdmissionPolicyBinding
    metadata:
      name: protect-apl-addons-appproject
    spec:
      policyName: protect-apl-addons-appproject
      validationActions:
        - Deny
