{{- $v := .Values }}
{{- $domainSuffix := $v.cluster.domainSuffix }}
{{- $issuer := $v.otomi | get "issuer" "keycloak" }}
{{- $adminUsername := (eq $issuer "dex") | ternary $v.apps.dex.adminUsername $v.apps.keycloak.adminUsername }}
{{- /* Login is always an email; "otomi-admin" (the default) maps to platform-admin@. */}}
{{- $localPart := (eq $adminUsername "otomi-admin") | ternary "platform-admin" $adminUsername }}
{{- $username := printf "%s@%s" $localPart $domainSuffix }}

resources:
  {{- /* The login shown in the welcome message. Same admin password used by whichever issuer is active. */}}
  - apiVersion: external-secrets.io/v1
    kind: ExternalSecret
    metadata:
      name: platform-admin-credentials
      namespace: apl-secrets
    spec:
      refreshInterval: 5m
      secretStoreRef:
        name: core-secrets-store
        kind: ClusterSecretStore
      target:
        name: platform-admin-credentials
        creationPolicy: Owner
        template:
          type: Opaque
          data:
            username: {{ $username }}
            password: '{{ "{{ .adminPassword | toString }}" }}'
      data:
        - secretKey: adminPassword
          remoteRef:
            key: otomi-secrets
            property: adminPassword
