{{- $v := .Values }}
{{- $t := $v.apps.tekton }}

{{- $tektonRegistry := "ghcr.io" }}
{{- $shellRegistry := "cgr.dev" }}
{{- with $v.otomi.linodeLkeImageRepository }}
{{- $tektonRegistry = print . "/ghcr" }}
{{- $shellRegistry = print . "/docker" }}
{{- end }}

namespace:
  labels:
    app.kubernetes.io/part-of: otomi
    app.kubernetes.io/instance: k8s

controller:
  resources: {{- $t.resources.pipelinesController | toYaml | nindent 4 }}
  nodeSelector: {{- toYaml $v.otomi.nodeSelector | nindent 4 }}
  deployment:
    image: "{{ $tektonRegistry }}/tektoncd/pipeline/controller-10a3e32792f33651396d02b6855a6e36:v1.15.3@sha256:b37f1ab9493f13134ae2d2e53661849d194a536e1f0abff7b3e1bba25895e934"
  images:
    entrypoint: "{{ $tektonRegistry }}/tektoncd/pipeline/entrypoint-bff0a22da108bc2f16c818c97641a296:v1.15.3@sha256:921ce1877b61ab463f4cbe3735f55a16933e7872deea295ac9f379d933046ffc"
    nop: "{{ $tektonRegistry }}/tektoncd/pipeline/nop-8eac7c133edad5df719dc37b36b62482:v1.15.3@sha256:5699415b90fefa379ecde7caea3f0b0dc97ef232a31108c343a71e5c6daa3db2"
    sidecarlogresults: "{{ $tektonRegistry }}/tektoncd/pipeline/sidecarlogresults-7501c6a20d741631510a448b48ab098f:v1.15.3@sha256:208aaf920aacc9c06b6e1d720f7d77bdbaad335acd17435acb0ebe53d958271a"
    workingdirinit: "{{ $tektonRegistry }}/tektoncd/pipeline/workingdirinit-0c558922ec6a1b739e550e349f2d5fc1:v1.15.3@sha256:1281e928781efd8b7a80f66e597f7226fb613bca1ef6c5bb1484ee9fcc5e99e1"
    {{- /* Note the image digest for Busybox differs from the upstream chart, as the old version used there is not available on Docker Hub */}}
    shellImage: "{{ $shellRegistry }}/chainguard/busybox@sha256-41cb1dbc33180ea94dcc96cbce7b53d872e728e755d872897db78b6eb3a988ef"

remoteresolver:
  resources: {{- $t.resources.pipelinesRemoteresolver | toYaml | nindent 4 }}
  nodeSelector: {{- toYaml $v.otomi.nodeSelector | nindent 4 }}
  deployment:
    image: "{{ $tektonRegistry }}/tektoncd/pipeline/resolvers-ff86b24f130c42b88983d3c13993056d:v1.15.3@sha256:a0b11089b7be39806cca023d790a86f4cae3f328cdc630fe314cf7500326112c"

eventscontroller:
  deployment:
    image: "{{ $tektonRegistry }}/tektoncd/pipeline/events-a9042f7efb0cbade2a868a1ee5ddd52c:v1.15.3@sha256:00797eeb0de769880a8f2b17de58cfc5f95e362836a1ec49edf255208a1acf04"

webhook:
  resources: {{- $t.resources.pipelinesWebhook | toYaml | nindent 4 }}
  nodeSelector: {{- toYaml $v.otomi.nodeSelector | nindent 4 }}
  deployment:
    image: "{{ $tektonRegistry }}/tektoncd/pipeline/webhook-d4749e605405422fd87700164e31b2d1:v1.15.3@sha256:f0f587620f9fb5a77ecfde7949a0104d5905276988f1359dc0b054f9ce6afc40"

configDefaults:
  default-pod-template: |
    priorityClassName: tekton-low
    nodeSelector: {{- toYaml $v.otomi.nodeSelector | nindent 6 }}
