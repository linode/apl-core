{{- $v := .Values }}

resources:
  - apiVersion: external-secrets.io/v1
    kind: ExternalSecret
    metadata:
      name: otomi
    spec:
      refreshPolicy: CreatedOnce
      target:
        name: otomi
        creationPolicy: Owner
        immutable: true
      dataFrom:
        - sourceRef:
            generatorRef:
              apiVersion: generators.external-secrets.io/v1alpha1
              kind: ClusterGenerator
              name: random-32
          rewrite:
            - regexp:
                source: password
                target: adminPassword
  - apiVersion: external-secrets.io/v1
    kind: ExternalSecret
    metadata:
      name: oauth2-proxy
    spec:
      refreshPolicy: CreatedOnce
      target:
        name: oauth2-proxy
        creationPolicy: Owner
        immutable: true
        template:
          data:
            cookieSecret: "{{ `{{ .password | b64enc }}` }}"
      dataFrom:
        - sourceRef:
            generatorRef:
              apiVersion: generators.external-secrets.io/v1alpha1
              kind: ClusterGenerator
              name: alpha-num-32
  - apiVersion: external-secrets.io/v1
    kind: ExternalSecret
    metadata:
      name: platform-admin-credentials
    spec:
      refreshPolicy: CreatedOnce
      target:
        name: platform-admin-credentials
        creationPolicy: Owner
        immutable: true
        template:
          type: Opaque
          data:
            username: platform-admin@{{ $v.cluster.domainSuffix }}
            password: "{{ `{{ .password }}` }}"
      dataFrom:
        - sourceRef:
            generatorRef:
              apiVersion: generators.external-secrets.io/v1alpha1
              kind: ClusterGenerator
              name: random-32
{{- if $v.apps.keycloak.enabled }}
  - apiVersion: external-secrets.io/v1
    kind: ExternalSecret
    metadata:
      name: platform-admin-credentials
      namespace: keycloak
    spec:
      refreshPolicy: CreatedOnce
      secretStoreRef:
        name: core-secrets-store
        kind: ClusterSecretStore
      target:
        name: platform-admin-credentials
        creationPolicy: Owner
        immutable: true
      data:
        - secretKey: username
          remoteRef:
            key: platform-admin-credentials
            property: username
        - secretKey: password
          remoteRef:
            key: platform-admin-credentials
            property: password
  - apiVersion: external-secrets.io/v1
    kind: ExternalSecret
    metadata:
      name: keycloak
    spec:
      refreshPolicy: CreatedOnce
      target:
        name: keycloak
        creationPolicy: Owner
        immutable: true
      dataFrom:
        - sourceRef:
            generatorRef:
              apiVersion: generators.external-secrets.io/v1alpha1
              kind: ClusterGenerator
              name: alpha-num-32
          rewrite:
            - regexp:
                source: password
                target: idpClientSecret
{{- end }}
{{- if $v.apps.dex.enabled }}
  - apiVersion: external-secrets.io/v1
    kind: ExternalSecret
    metadata:
      name: dex
    spec:
      refreshPolicy: CreatedOnce
      target:
        name: dex
        creationPolicy: Owner
        immutable: true
      dataFrom:
        - sourceRef:
            generatorRef:
              apiVersion: generators.external-secrets.io/v1alpha1
              kind: ClusterGenerator
              name: alpha-num-32
          rewrite:
            - regexp:
                source: password
                target: idpClientSecret
        - sourceRef:
            generatorRef:
              apiVersion: generators.external-secrets.io/v1alpha1
              kind: ClusterGenerator
              name: alpha-num-32
          rewrite:
            - regexp:
                source: password
                target: sessionCookieEncryptionKey
{{- end }}
{{- if $v.apps.gitea.enabled }}
  - apiVersion: external-secrets.io/v1
    kind: ExternalSecret
    metadata:
      name: gitea
    spec:
      refreshPolicy: CreatedOnce
      target:
        name: gitea
        creationPolicy: Owner
        immutable: true
        template:
          data:
            adminUsername: {{ $v.apps.gitea.adminUsername | quote }}
            adminPassword: "{{ `{{ .adminPassword }}` }}"
            valkeyPassword: "{{ `{{ .valkeyPassword }}` }}"
      dataFrom:
        - sourceRef:
            generatorRef:
              apiVersion: generators.external-secrets.io/v1alpha1
              kind: ClusterGenerator
              name: alpha-num-32
          rewrite:
            - regexp:
                source: password
                target: adminPassword
        - sourceRef:
            generatorRef:
              apiVersion: generators.external-secrets.io/v1alpha1
              kind: ClusterGenerator
              name: alpha-num-32
          rewrite:
            - regexp:
                source: password
                target: valkeyPassword
{{- end }}
{{- if $v.apps.harbor.enabled }}
  - apiVersion: external-secrets.io/v1
    kind: ExternalSecret
    metadata:
      name: harbor
    spec:
      refreshPolicy: CreatedOnce
      target:
        name: harbor
        creationPolicy: Owner
        immutable: true
        template:
          data:
            registryUsername: {{ $v.apps.harbor.registry.credentials.username | quote }}
            registryPassword: "{{ `{{ .password }}` }}"
      dataFrom:
        - sourceRef:
            generatorRef:
              apiVersion: generators.external-secrets.io/v1alpha1
              kind: ClusterGenerator
              name: alpha-num-32
{{- end }}
  - apiVersion: external-secrets.io/v1
    kind: ExternalSecret
    metadata:
      name: loki
    spec:
      refreshPolicy: CreatedOnce
      target:
        name: loki
        creationPolicy: Owner
        immutable: true
        template:
          data:
            adminUsername: "otomi-admin"
            adminPassword: "{{ `{{ .password }}` }}"
      dataFrom:
        - sourceRef:
            generatorRef:
              apiVersion: generators.external-secrets.io/v1alpha1
              kind: ClusterGenerator
              name: alpha-num-32
