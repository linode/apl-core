{{- $v := .Values }}
{{- $a := $v.apps }}
{{- $oa := $v.apps | get "otomi-api" }}

# Simple per-app network policy configuration
netpols:
  gitServer: {{ not ($a | get "git-server.enabled") }}
  gitea: {{ $a.gitea.networkPolicies.enabled}}
  otomiApi: {{ $oa.networkPolicies.enabled}}
  loki: {{ and $a.loki.enabled $a.loki.networkPolicies.enabled }}
  dex: {{ and $a.dex.enabled $a.dex.networkPolicies.enabled }}

ingressGatewaySelectors:
  - namespaceSelector:
      matchLabels:
        name: istio-system
    podSelector:
      matchLabels:
        gateway.networking.k8s.io/gateway-name: {{ $v.ingress.platformClass.className }}

# Managed Grafana instances of the teams, which are allowed to query platform data sources
teamGrafanaSelectors:
{{- range $teamId, $team := omit $v.teamConfig "admin" }}
{{- if $team | get "settings.managedMonitoring.grafana" false }}
  - namespaceSelector:
      matchLabels:
        name: team-{{ $teamId }}
    podSelector:
      matchLabels:
        app.kubernetes.io/name: {{ $teamId }}-po-grafana
{{- end }}
{{- end }}
