# will bypass docker but expects all binaries present on host
VERBOSITY=2
# will disable contacting the cluster as found in kube context:
DISABLE_SYNC=1
# uncommenting the NEXT 2 lines will disable DEV mode to test more closely to the real deal
# NOT_CORE=1
# NODE_PATH=dist
# ENV_DIR=''

# KMS access from here on
SOPS_AGE_KEY=''
NODE_ENV=development
RETRIES=6
RANDOM=false
MIN_TIMEOUT=10000
FACTOR=1

# GIT_REPO_URL='http://git-server.git-server.svc.cluster.local:8080/otomi/values.git'
# GIT_REPO_URL='http://127.0.0.1:8080/otomi/values.git'
